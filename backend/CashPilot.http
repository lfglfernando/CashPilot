@CashPilot_HostAddress = http://localhost:5241
# Paste the accessToken returned by POST /auth/login.
@CashPilot_AccessToken =

GET {{CashPilot_HostAddress}}/transaction/all
Accept: application/json

###

# Profit: 40 per unit, 40% margin.
POST {{CashPilot_HostAddress}}/api/calculators/product-profit
Authorization: Bearer {{CashPilot_AccessToken}}
Content-Type: application/json

{
  "sellingPrice": 100,
  "costPrice": 60
}

###

# Loss: -25 per unit, -50% margin.
POST {{CashPilot_HostAddress}}/api/calculators/product-profit
Authorization: Bearer {{CashPilot_AccessToken}}
Content-Type: application/json

{
  "sellingPrice": 50,
  "costPrice": 75
}

###

# Zero cost: 19.99 profit, 100% margin.
POST {{CashPilot_HostAddress}}/api/calculators/product-profit
Authorization: Bearer {{CashPilot_AccessToken}}
Content-Type: application/json

{
  "sellingPrice": 19.99,
  "costPrice": 0
}

###

# Invalid price and cost: expect 400.
POST {{CashPilot_HostAddress}}/api/calculators/product-profit
Authorization: Bearer {{CashPilot_AccessToken}}
Content-Type: application/json

{
  "sellingPrice": 0,
  "costPrice": -1
}

###

# Too many decimals: expect 400.
POST {{CashPilot_HostAddress}}/api/calculators/product-profit
Authorization: Bearer {{CashPilot_AccessToken}}
Content-Type: application/json

{
  "sellingPrice": 10.001,
  "costPrice": 5
}

###

# Missing price and cost: expect 400.
POST {{CashPilot_HostAddress}}/api/calculators/product-profit
Authorization: Bearer {{CashPilot_AccessToken}}
Content-Type: application/json

{}

###
